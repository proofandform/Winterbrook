# dependencies
/node_modules

# next.js build output (regenerated by `next build` / `next dev`)
/.next
/out
next-env.d.ts
*.tsbuildinfo

# vercel project link + CLI-issued credentials
/.vercel
.env*

# machine-local tooling state
.claude/settings.local.json
.DS_Store

# crawled source originals (671MB) — the site serves the web-optimised
# copies in /public/images; regenerate via `npm run optimize-images` locally
/assets

# separate project (rre.ie rebuild) that lives inside this folder;
# excluded from tsconfig and .vercelignore for the same reason
/rre
